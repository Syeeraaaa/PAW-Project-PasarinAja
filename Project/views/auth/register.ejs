<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registrasi Pelaku UMKM - Paseban Kawis</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { theme: { extend: { colors: { primary: '#065F46' } } } }
    </script>
</head>
<body class="bg-primary min-h-screen flex items-center justify-center p-6">
    <div class="bg-white rounded-3xl p-8 md:p-12 shadow-2xl w-full max-w-md">
        <h2 class="text-3xl font-extrabold text-primary text-center mb-8">Registrasi</h2>
        <form action="/register" method="POST" class="space-y-5">
            <div>
                <input type="text" name="username" placeholder="Masukkan Username" required class="w-full bg-gray-50 border-2 border-gray-200 rounded-2xl px-5 py-4 text-base focus:outline-none focus:border-primary">
            </div>
            <div>
                <input type="email" name="email" placeholder="Masukkan Email" required class="w-full bg-gray-50 border-2 border-gray-200 rounded-2xl px-5 py-4 text-base focus:outline-none focus:border-primary">
            </div>
            <div>
                <input type="password" name="password" placeholder="Masukkan Password" required class="w-full bg-gray-50 border-2 border-gray-200 rounded-2xl px-5 py-4 text-base focus:outline-none focus:border-primary">
            </div>
            <button type="submit" class="w-full bg-primary text-white font-bold py-4 rounded-2xl text-lg hover:bg-emerald-900 transition shadow-md">
                Daftar
            </button>
        </form>
        <p class="text-center text-gray-600 text-sm mt-6">
            Sudah punya akun? <a href="/login" class="text-primary font-bold hover:underline">Login</a>
        </p>
    </div>
</body>
</html>