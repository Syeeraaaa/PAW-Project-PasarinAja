<%
  const gambar = '/images/login.jpg'; // ganti dengan nama file gambar di public/images
  const input = 'w-full border rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-700';
  const warna = error ? 'border-red-500' : 'border-gray-300';
%>
<%- include('../partials/head', { title: `Masuk - ${appName}` }) %>
<body class="font-sans text-gray-800">
<!-- Gambar dijadikan background full layar -->
<div class="min-h-screen flex items-center justify-center bg-emerald-900 bg-cover bg-center p-4 sm:p-6 relative" 
     style="background-image: url('<%= gambar %>');">
    
    <!-- Overlay gelap sedikit agar form lebih menonjol (opsional, bisa dihapus) -->
    <div class="absolute inset-0 bg-black/30"></div>

    <!-- Card Form -->
    <div class="relative w-full max-w-md bg-white rounded-3xl shadow-2xl p-6 sm:p-8">
        <a href="/" class="text-xs text-emerald-700 hover:underline">&larr; Kembali ke beranda</a>
        <h1 class="text-3xl font-extrabold text-[#17714A] text-center mt-3 mb-6">LOGIN</h1>

        <% if (info) { %>
            <div class="bg-emerald-100 text-emerald-800 text-sm font-semibold rounded-xl px-4 py-3 mb-4"><%= info %></div>
        <% } %>
        <% if (error) { %>
            <div class="bg-red-100 text-red-700 text-sm font-semibold rounded-xl px-4 py-3 mb-4" role="alert"><%= error %></div>
        <% } %>

        <form id="form-login" method="POST" action="/login" novalidate class="space-y-4">
            <div>
                <label for="username" class="text-sm font-medium">Username</label>
                <input id="username" name="username" value="<%= username %>" autocomplete="username" placeholder="Masukkan Username" class="<%= input %> <%= warna %>">
                <p data-untuk="username" class="hidden text-xs text-red-600 mt-1"></p>
            </div>
            <div>
                <label for="password" class="text-sm font-medium">Password</label>
                <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Masukkan Password" class="<%= input %> <%= warna %>">
                <p data-untuk="password" class="hidden text-xs text-red-600 mt-1"></p>
            </div>
            <button class="w-full bg-[#17714A] hover:bg-emerald-900 text-white font-bold py-3 rounded-xl transition">Login</button>
        </form>

        <p class="text-center text-sm mt-6">Belum punya akun? <a href="/register" class="font-bold underline text-[#17714A]">Register</a></p>
    </div>
</div>
<script>
    (function () {
        var form = document.getElementById('form-login');

        function tampilkan(nama, pesan) {
            var teks = form.querySelector('[data-untuk="' + nama + '"]');
            var input = form.elements[nama];
            teks.textContent = pesan;
            teks.classList.toggle('hidden', !pesan);
            input.classList.toggle('border-red-500', !!pesan);
            input.classList.toggle('border-gray-300', !pesan);
        }

        form.addEventListener('submit', function (e) {
            var username = form.elements.username.value.trim();
            var password = form.elements.password.value;
            tampilkan('username', username ? '' : 'Username wajib diisi');
            tampilkan('password', password ? '' : 'Password wajib diisi');
            if (!username || !password) e.preventDefault();
        });
    })();
</script>
</body>
</html>