<%
  const menu = [
    { href: '/katalog', judul: 'E-Katalog', ket: 'Lihat Produk' },
    { href: '/umkm/akun', judul: 'Akun Saya', ket: 'Informasi pemilik akun' },
    { href: '/chatbot', judul: 'Chatbot AI', ket: 'Tanya AI' },
    { href: '/umkm/produk', judul: 'Kelola Produk', ket: 'Pengelolaan Produk' },
  ];
%>
<%- include('../partials/head', { appName: appName }) %>
<body class="bg-gray-50 text-gray-800 font-sans">
<div class="min-h-screen flex flex-col md:flex-row">
    <%- include('../partials/umkm-sidebar', { aktif: 'dashboard' }) %>

    <main class="flex-1 p-6 md:p-10 max-w-5xl">
        <h2 class="text-3xl font-extrabold text-gray-900">Dashboard</h2>
        <p class="text-gray-600 mb-6">Selamat datang kembali, <%= umkm.nama_pemilik %>!</p>

        <div class="bg-emerald-50 border border-emerald-100 rounded-3xl p-6 mb-8">
            <h3 class="font-bold text-lg">Kelola usaha lebih mudah</h3>
            <p class="text-gray-700">Promosikan produk dan kembangkan UMKM anda!</p>
        </div>

        <h3 class="font-bold mb-3">Menu Utama</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-8">
            <% menu.forEach(function (m) { %>
                <a href="<%= m.href %>" class="block bg-gray-100 hover:bg-emerald-50 border border-transparent hover:border-emerald-300 rounded-3xl p-6 transition">
                    <h4 class="font-bold"><%= m.judul %></h4>
                    <p class="text-gray-600 mt-2"><%= m.ket %></p>
                </a>
            <% }); %>
        </div>

        <h3 class="font-bold mb-3">Akses Cepat</h3>
        <a href="/umkm/pendaftaran" class="block bg-gray-100 hover:bg-emerald-50 border border-transparent hover:border-emerald-300 rounded-2xl p-8 text-center font-bold transition">
            Form Pendaftaran UMKM
        </a>
    </main>
</div>
<%- include('../partials/footer') %>