<%
  const input = 'w-full border border-gray-300 rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-emerald-700';
  const label = { menunggu: 'Menunggu verifikasi', disetujui: 'Terverifikasi', ditolak: 'Ditolak' };
  const nama = umkm ? umkm.nama_pemilik : user.username;
%>
<%- include('../partials/head', { appName: appName }) %>
<body class="bg-gray-50 text-gray-800 font-sans">
<div class="min-h-screen flex flex-col md:flex-row">
    <%- include('../partials/sidebar', { aktif: 'akun' }) %>

    <main class="flex-1 min-w-0 p-4 sm:p-6 md:p-10">
        <div class="max-w-3xl">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900">Akun Saya</h2>
            <p class="text-gray-600 mb-6">Kelola informasi akun anda</p>

            <div class="bg-gray-100 rounded-2xl p-6 sm:p-8 text-center mb-6">
                <div class="w-20 h-20 sm:w-24 sm:h-24 mx-auto rounded-full bg-gray-300 flex items-center justify-center text-3xl sm:text-4xl">
                    <%= nama.charAt(0).toUpperCase() %>
                </div>
                <p class="mt-3 text-sm"><%= nama %></p>
                <p class="font-medium">Pemilik UMKM</p>
                <div class="flex flex-wrap justify-center gap-3 mt-5">
                    <% if (umkm) { %>
                        <button type="button" onclick="togglePanel('form-edit')" class="bg-[#065F46] hover:bg-emerald-800 text-white font-semibold px-6 py-2.5 rounded-xl">Edit Profil</button>
                    <% } %>
                    <a href="/logout" onclick="return confirm('Yakin ingin keluar?')" class="bg-red-600 hover:bg-red-700 text-white font-semibold px-6 py-2.5 rounded-xl">Logout</a>
                </div>
            </div>

            <% if (umkm) { %>
                <div id="form-edit" class="hidden bg-white rounded-2xl border border-gray-200 p-5 mb-6">
                    <form method="POST" action="/umkm/akun" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <input name="nama_pemilik" value="<%= umkm.nama_pemilik %>" placeholder="Nama lengkap" required class="<%= input %>">
                        <input name="nama_usaha" value="<%= umkm.nama_usaha %>" placeholder="Nama usaha UMKM" required class="<%= input %>">
                        <input name="no_whatsapp" value="<%= umkm.no_whatsapp || '' %>" placeholder="No. WhatsApp" class="<%= input %> md:col-span-2">
                        <div class="md:col-span-2 flex flex-wrap gap-2">
                            <button class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-5 py-2 rounded-xl text-sm">Simpan Perubahan</button>
                            <button type="button" onclick="togglePanel('form-edit')" class="border border-gray-300 px-5 py-2 rounded-xl text-sm">Batal</button>
                        </div>
                    </form>
                </div>
            <% } %>

            <div class="bg-gray-100 rounded-2xl p-6 sm:p-8 space-y-4">
                <h3 class="text-xl">Informasi akun</h3>
                <div><p class="text-sm text-gray-500">Username</p><p class="text-lg"><%= user.username %></p></div>
                <div><p class="text-sm text-gray-500">Email</p><p class="text-lg break-all"><%= user.email %></p></div>
                <% if (umkm) { %>
                    <div><p class="text-sm text-gray-500">Nama lengkap</p><p class="text-lg"><%= umkm.nama_pemilik %></p></div>
                    <div><p class="text-sm text-gray-500">Nama usaha UMKM</p><p class="text-lg"><%= umkm.nama_usaha %></p></div>
                    <div><p class="text-sm text-gray-500">No. WhatsApp</p><p class="text-lg"><%= umkm.no_whatsapp || '-' %></p></div>
                    <div><p class="text-sm text-gray-500">Status</p><p class="text-lg"><%= label[umkm.status] %></p></div>
                <% } else { %>
                    <p class="text-sm text-gray-600">Kamu belum mendaftarkan UMKM.
                        <a href="/umkm/pendaftaran" class="text-emerald-700 underline">Isi form pendaftaran</a>
                    </p>
                <% } %>
            </div>
        </div>
    </main>
</div>

<script>
    function togglePanel(id) {
        document.getElementById(id).classList.toggle('hidden');
    }
</script>
<%- include('../partials/footer') %>