<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Akun Saya - Paseban Kawis</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = { theme: { extend: { colors: { primary: '#065F46' } } } }
    </script>
</head>
<body class="bg-gray-50 text-gray-800 font-sans">
    <div class="min-h-screen flex flex-col md:flex-row">
        <!-- Sidebar -->
        <aside class="w-full md:w-72 bg-primary text-white p-6 flex flex-col justify-between">
            <div>
                <h1 class="text-xl font-extrabold tracking-wide mb-10">PASEBAN KAWIS</h1>
                <nav class="space-y-3">
                    <a href="/umkm/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-emerald-900/50 font-medium text-lg transition"><i class="fa-solid fa-house"></i> Dashboard</a>
                    <a href="/umkm/katalog" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-emerald-900/50 font-medium text-lg transition"><i class="fa-solid fa-basket-shopping"></i> E-Katalog</a>
                    <a href="/umkm/produk" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-emerald-900/50 font-medium text-lg transition"><i class="fa-solid fa-box"></i> Kelola Produk</a>
                    <a href="/umkm/chatbot" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-emerald-900/50 font-medium text-lg transition"><i class="fa-solid fa-robot"></i> Chatbot AI</a>
                    <a href="/umkm/pendaftaran" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-emerald-900/50 font-medium text-lg transition"><i class="fa-solid fa-file-pen"></i> Form Pendaftaran</a>
                </nav>
            </div>
            <div class="pt-6 border-t border-emerald-800">
                <a href="/umkm/akun" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-emerald-900 font-bold text-lg"><i class="fa-solid fa-user"></i> Akun Saya</a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 p-8 md:p-12 space-y-8 max-w-4xl">
            <div>
                <h2 class="text-3xl font-extrabold text-gray-900 mb-1">Akun Saya</h2>
                <p class="text-gray-600 text-base">Kelola informasi akun anda</p>
            </div>

            <!-- Profile Card Header -->
            <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-200 text-center space-y-4">
                <div class="w-24 h-24 bg-gray-200 text-gray-700 rounded-full flex items-center justify-center text-4xl font-extrabold mx-auto">
                    K
                </div>
                <div>
                    <h3 class="text-2xl font-bold text-gray-800">Kelompok Dua</h3>
                    <p class="text-gray-500 text-base">Pemilik UMKM</p>
                </div>
                <div class="pt-2">
                    <a href="/umkm/akun/edit" class="inline-block bg-primary text-white font-bold px-8 py-3 rounded-xl hover:bg-emerald-900 transition shadow-sm">
                        Edit Profil
                    </a>
                </div>
            </div>

            <!-- Account Information Details -->
            <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-200 space-y-6">
                <h3 class="text-2xl font-bold text-gray-800 border-b pb-4">Informasi akun</h3>
                
                <div class="space-y-4 text-base">
                    <div>
                        <span class="text-gray-400 block text-sm">Nama lengkap</span>
                        <strong class="text-xl text-gray-800">Kelompok Dua</strong>
                    </div>
                    <div>
                        <span class="text-gray-400 block text-sm">Nama usaha UMKM</span>
                        <strong class="text-xl text-gray-800">Sambal Kemasan</strong>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>