<%- include('../partials/head', { appName: appName }) %>
<body class="bg-gray-50 text-gray-800 font-sans">
    <div class="min-h-screen flex flex-col md:flex-row">
        <!-- Sidebar -->
        <aside class="w-full md:w-72 bg-primary text-white p-6 flex flex-col justify-between">
            <div>
                <h1 class="text-xl font-extrabold tracking-wide mb-10">PASEBAN KAWIS</h1>
                <nav class="space-y-4">
                    <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-emerald-900/50 font-medium text-lg transition"><i class="fa-solid fa-house"></i> Dashboard</a>
                    <a href="/katalog" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-emerald-900/50 font-medium text-lg transition"><i class="fa-solid fa-basket-shopping"></i> E-Katalog</a>
                    <a href="/chatbot" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-emerald-900 font-bold text-lg"><i class="fa-solid fa-robot"></i> Chatbot AI</a>
                </nav>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 p-8 md:p-12">
            <h2 class="text-3xl font-extrabold text-gray-900 mb-1">Chatbot AI</h2>
            <p class="text-gray-600 text-base mb-6">Asisten pintar yang siap membantu usaha UMKM anda!</p>

            <!-- Chat Window Box -->
            <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-200 max-w-4xl flex flex-col h-[550px] justify-between">
                <!-- Chat Messages Area -->
                <div class="space-y-4 overflow-y-auto pr-2">
                    <div class="bg-emerald-50 text-emerald-900 p-4 rounded-2xl max-w-lg text-base">
                        Halo! ada yang bisa saya bantu untuk mengembangkan usahamu?
                    </div>
                    <div class="flex justify-end">
                        <div class="bg-primary text-white p-4 rounded-2xl max-w-lg text-base">
                            Bagaimana cara promosi produk
                        </div>
                    </div>
                </div>

                <!-- Input Box -->
                <div class="pt-4 border-t border-gray-100 relative">
                    <input type="text" placeholder="Tulis pertanyaanmu....." class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-5 py-4 pr-14 text-base focus:outline-none focus:border-primary">
                    <button class="absolute right-4 top-7 text-primary hover:text-emerald-900 text-xl font-bold">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </div>
            </div>
        </main>
    </div>
<%- include('../partials/footer') %>