<!-- views/publik/dashboard.ejs -->
<%- include('../partials/head', { title: `Dashboard - ${appName}` }) %>

<body class="bg-gray-50 flex flex-col md:flex-row min-h-screen">

    <!-- Sidebar Publik -->
    <%- include('../partials/publik-sidebar') %>

    <!-- Konten Utama -->
    <main class="flex-1 p-8">
        <header class="mb-8">
            <h2 class="text-2xl font-bold text-gray-800">Selamat Datang di <%= appName %></h2>
            <p class="text-gray-600">Pusat katalog produk UMKM resmi Desa Paseban Kawis.</p>
        </header>

        <!-- Banner Sambutan / Hero Section -->
        <div class="bg-emerald-600 rounded-2xl p-8 text-white shadow-sm mb-8">
            <h3 class="text-3xl font-bold mb-2">Dukung Produk Lokal Berkualitas</h3>
            <p class="text-emerald-100 mb-6 max-w-xl">Temukan berbagai hasil kerajinan tangan, olahan makanan khas, hingga produk pertanian langsung dari tangan pelaku UMKM desa.</p>
            <a href="/katalog" class="inline-block bg-white text-emerald-600 font-semibold px-6 py-2.5 rounded-lg shadow hover:bg-emerald-50 transition-colors">
                Jelajahi Katalog
            </a>
        </div>
    </main>

<%- include('../partials/footer') %>
</body>