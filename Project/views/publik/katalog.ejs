<!-- views/publik/katalog.ejs -->
<%- include('../partials/head', { title: `E-Katalog - ${appName}` }) %>
<body class="bg-gray-50 text-gray-800 font-sans">
<div class="min-h-screen flex flex-col md:flex-row">
    <%- include('../partials/publik-sidebar', { aktif: 'katalog' }) %>

    <main class="flex-1 min-w-0 p-6 md:p-10">
        <div class="max-w-5xl">
            <h2 class="text-3xl font-extrabold text-gray-900">E-Katalog</h2>
            <p class="text-gray-600 mb-6">Daftar produk UMKM</p>

            <!-- Pencarian -->
            <form method="GET" action="/katalog" class="relative mb-4">
                <input type="text" name="q" value="<%= q %>" placeholder="Cari produk....." aria-label="Cari produk"
                       class="w-full bg-white border border-gray-200 rounded-xl px-5 py-4 pr-14 focus:outline-none focus:ring-2 focus:ring-emerald-700">
                <button type="submit" aria-label="Cari" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-emerald-700">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3" stroke-linecap="round"/></svg>
                </button>
            </form>

            <% if (q) { %>
                <p class="text-sm text-gray-500 mb-4">
                    <%= produk.length %> produk ditemukan untuk "<%= q %>".
                    <a href="/katalog" class="text-emerald-700 underline">Hapus pencarian</a>
                </p>
            <% } %>

            <% if (produk.length === 0) { %>
                <div class="bg-white border border-gray-200 rounded-2xl p-10 text-center text-gray-500">
                    <%= q ? 'Produk tidak ditemukan.' : 'Belum ada produk yang ditampilkan.' %>
                </div>
            <% } else { %>
                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
                    <% produk.forEach(function (p) { %>
                        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden flex flex-col">
                            <div class="relative h-48 bg-emerald-50 flex items-center justify-center text-5xl font-bold text-emerald-300">
                                <span><%= p.nama.charAt(0).toUpperCase() %></span>
                                <% if (p.gambar) { %>
                                    <img src="<%= p.gambar %>" alt="<%= p.nama %>" class="absolute inset-0 w-full h-full object-cover" onerror="this.remove()">
                                <% } %>
                            </div>
                            <div class="p-5 flex flex-col flex-1">
                                <span class="self-start text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full"><%= p.kategori %></span>
                                <h3 class="text-lg font-bold mt-3"><%= p.nama %></h3>
                                <p class="text-sm text-gray-500"><%= p.umkm || '-' %></p>
                                <p class="text-lg font-bold text-[#065F46] mt-2"><%= formatRupiah(p.harga) %></p>
                                <div class="mt-auto pt-4">
                                    <a href="/produk/<%= p.id %>" class="block w-full bg-[#065F46] hover:bg-emerald-900 text-white text-center font-bold py-3 rounded-xl transition">Lihat Detail</a>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </main>
</div>
<%- include('../partials/footer') %>