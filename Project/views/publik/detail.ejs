<!-- views/publik/detail.ejs -->
<%
  let waNumber = produk.no_whatsapp ? produk.no_whatsapp.replace(/\D/g, '') : '';
  if (waNumber.startsWith('0')) waNumber = '62' + waNumber.slice(1);
  const adaWA = waNumber.length >= 9;
  const pesanWA = encodeURIComponent(`Halo, saya tertarik dengan produk ${produk.nama} yang ada di ${appName}. Apakah stoknya masih tersedia?`);
%>
<%- include('../partials/head', { title: `${produk.nama} - ${appName}` }) %>
<body class="bg-gray-50 text-gray-800 font-sans">
<div class="min-h-screen flex flex-col md:flex-row">
    <%- include('../partials/publik-sidebar', { aktif: 'katalog' }) %>

    <main class="flex-1 min-w-0 p-6 md:p-10">
        <div class="max-w-5xl">
            <a href="/katalog" class="text-sm text-emerald-700 hover:underline">&larr; Kembali ke Katalog</a>

            <div class="mt-4 bg-white rounded-2xl border border-gray-200 shadow-sm p-6 md:p-8 grid grid-cols-1 md:grid-cols-2 gap-8">

                <!-- Foto produk -->
                <div class="relative h-72 md:h-96 bg-emerald-50 rounded-xl overflow-hidden flex items-center justify-center text-7xl font-bold text-emerald-300">
                    <span><%= produk.nama.charAt(0).toUpperCase() %></span>
                    <% if (produk.gambar) { %>
                        <img src="<%= produk.gambar %>" alt="<%= produk.nama %>" class="absolute inset-0 w-full h-full object-cover" onerror="this.remove()">
                    <% } %>
                </div>

                <!-- Informasi produk -->
                <div class="flex flex-col justify-between">
                    <div>
                        <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full"><%= produk.kategori %></span>
                        <h2 class="text-3xl font-bold text-gray-800 mt-3"><%= produk.nama %></h2>
                        <p class="text-sm text-gray-500 mt-1">Pelaku UMKM: <span class="font-medium text-gray-700"><%= produk.umkm || '-' %></span></p>
                        <p class="text-2xl font-bold text-[#065F46] mt-4"><%= formatRupiah(produk.harga) %></p>
                        <p class="text-gray-600 mt-4 leading-relaxed"><%= produk.deskripsi || 'Tidak ada deskripsi produk.' %></p>
                        <p class="text-sm mt-4 <%= produk.stok > 0 ? 'text-gray-500' : 'text-red-600 font-semibold' %>">
                            <%= produk.stok > 0 ? `Stok tersedia: ${produk.stok} pcs` : 'Stok habis' %>
                        </p>
                    </div>

                    <!-- Tombol WhatsApp (hanya muncul kalau nomor penjual ada) -->
                    <div class="mt-8 pt-6 border-t border-gray-100">
                        <% if (adaWA) { %>
                            <a href="https://wa.me/<%= waNumber %>?text=<%= pesanWA %>" target="_blank" rel="noopener"
                               class="flex items-center justify-center gap-2 w-full bg-emerald-700 text-white font-semibold py-3 px-6 rounded-xl hover:bg-emerald-800 transition shadow-sm">
                                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                                Hubungi Penjual via WhatsApp
                            </a>
                        <% } else { %>
                            <p class="text-sm text-gray-500 text-center">Nomor WhatsApp penjual belum tersedia.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
<%- include('../partials/footer') %>