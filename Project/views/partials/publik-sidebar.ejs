<%
  const menu = [
    { key: 'dashboard', href: '/', label: 'Dashboard' },
    { key: 'katalog', href: '/katalog', label: 'E-Katalog' },
    { key: 'chatbot', href: '/chatbot', label: 'Chatbot AI' },
  ];
  const aktifCls = 'bg-emerald-700 font-bold';
  const biasaCls = 'hover:bg-emerald-800/60 font-medium';
%>
<aside class="w-full md:w-60 shrink-0 bg-[#065F46] text-white p-5 flex flex-col justify-between md:min-h-screen">
    <div>
        <h1 class="text-lg font-extrabold tracking-wide mb-8">PASEBAN KAWIS</h1>
        <nav class="space-y-2">
            <% menu.forEach(function (m) { %>
                <a href="<%= m.href %>" class="block px-4 py-2.5 rounded-xl transition <%= aktif === m.key ? aktifCls : biasaCls %>"><%= m.label %></a>
            <% }); %>
        </nav>
    </div>
    <a href="/login" class="block px-4 py-2.5 rounded-xl transition mt-6 hover:bg-emerald-800/60 font-medium">Masuk sebagai UMKM</a>
</aside>