<%
  const badge = { menunggu: 'bg-amber-100 text-amber-700', disetujui: 'bg-emerald-100 text-emerald-700', ditolak: 'bg-red-100 text-red-700' };
  const label = { menunggu: 'Menunggu', disetujui: 'Disetujui', ditolak: 'Ditolak' };
%>
<%- include('../partials/head', { appName: appName }) %>
<body class="bg-gray-50 text-gray-800 font-sans">
<div class="min-h-screen flex flex-col md:flex-row">
    <%- include('../partials/sidebar', { aktif: 'dashboard' }) %>

    <main class="flex-1 p-6 md:p-10">
        <h2 class="text-3xl font-extrabold text-gray-900">Dashboard Admin</h2>
        <p class="text-gray-600 mb-8">Selamat datang kembali, Admin!</p>

        <!-- Statistik (dari database) -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
            <div class="bg-emerald-50 border border-emerald-100 rounded-3xl p-5 text-center">
                <span class="font-bold text-sm">Total UMKM</span>
                <p class="text-5xl font-light mt-2"><%= stats.totalUmkm %></p>
            </div>
            <div class="bg-blue-50 border border-blue-100 rounded-3xl p-5 text-center">
                <span class="font-bold text-sm">Total Produk</span>
                <p class="text-5xl font-light mt-2"><%= stats.totalProduk %></p>
            </div>
            <div class="bg-amber-50 border border-amber-100 rounded-3xl p-5 text-center">
                <span class="font-bold text-sm">Menunggu verifikasi</span>
                <p class="text-5xl font-light mt-2"><%= stats.menunggu %></p>
            </div>
            <div class="bg-purple-50 border border-purple-100 rounded-3xl p-5 text-center">
                <span class="font-bold text-sm">Terverifikasi</span>
                <p class="text-5xl font-light mt-2"><%= stats.disetujui %></p>
            </div>
        </div>

        <!-- Pendaftar terbaru -->
        <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-200 max-w-5xl">
            <h3 class="text-xl font-bold mb-4">Pendaftar Terbaru</h3>

            <% if (terbaru.length === 0) { %>
                <p class="text-sm text-gray-500">Belum ada pendaftar.</p>
            <% } %>

            <div class="space-y-3">
                <% terbaru.forEach(function (u) { %>
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 bg-gray-50 rounded-2xl border border-gray-100">
                        <div class="flex items-center gap-4">
                            <div class="relative w-14 h-14 shrink-0 rounded-xl bg-emerald-100 text-emerald-800 font-bold flex items-center justify-center overflow-hidden">
                                <span><%= u.nama_usaha.charAt(0).toUpperCase() %></span>
                                <% if (u.foto) { %>
                                    <img src="<%= u.foto %>" alt="" class="absolute inset-0 w-full h-full object-cover" onerror="this.remove()">
                                <% } %>
                            </div>
                            <div>
                                <h4 class="font-bold"><%= u.nama_usaha %></h4>
                                <p class="text-xs text-gray-500">Kategori: <%= u.kategori %></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="<%= badge[u.status] %> text-xs font-bold px-3 py-1.5 rounded-full"><%= label[u.status] %></span>
                            <% if (u.status === 'menunggu') { %>
                                <form method="POST" action="/admin/umkm/<%= u.id %>/verifikasi">
                                    <button class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-4 py-2 rounded-xl text-sm">Verifikasi</button>
                                </form>
                                <form method="POST" action="/admin/umkm/<%= u.id %>/tolak">
                                    <button class="bg-red-100 hover:bg-red-200 text-red-700 font-bold px-4 py-2 rounded-xl text-sm">Tolak</button>
                                </form>
                            <% } %>
                            <a href="/admin/umkm#detail-<%= u.id %>" class="border border-emerald-700 text-emerald-700 hover:bg-emerald-50 font-bold px-4 py-2 rounded-xl text-sm">Detail</a>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </main>
</div>
<%- include('../partials/footer') %>