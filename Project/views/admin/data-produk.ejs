<%
  const badge = { menunggu: 'bg-amber-100 text-amber-700', ditampilkan: 'bg-emerald-100 text-emerald-700', ditolak: 'bg-red-100 text-red-700' };
  const label = { menunggu: 'Menunggu', ditampilkan: 'Ditampilkan', ditolak: 'Ditolak' };
  const input = 'w-full border border-gray-300 rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-emerald-700';
  const chips = [
    { nilai: '', teks: 'Semua' },
    { nilai: 'menunggu', teks: 'Menunggu' },
    { nilai: 'ditampilkan', teks: 'Ditampilkan' },
    { nilai: 'ditolak', teks: 'Ditolak' },
  ];
%>
<%- include('../partials/head', { appName: appName }) %>
<body class="bg-gray-50 text-gray-800 font-sans">
<div class="min-h-screen flex flex-col md:flex-row">
    <%- include('../partials/admin-sidebar', { aktif: 'produk' }) %>

    <main class="flex-1 p-6 md:p-10">
        <h2 class="text-3xl font-extrabold text-gray-900">Data Produk</h2>
        <p class="text-gray-600 mb-6">Kelola seluruh data produk UMKM Desa Paseban Kawis.</p>

        <!-- Pencarian -->
        <form method="GET" action="/admin/produk" class="flex gap-2 mb-4 max-w-5xl">
            <input type="hidden" name="status" value="<%= status %>">
            <input type="text" name="q" value="<%= q %>" placeholder="Cari Produk..." class="flex-1 bg-white border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-emerald-700">
            <button type="submit" class="bg-white border border-gray-200 hover:bg-gray-100 px-5 rounded-xl font-semibold text-emerald-700">Cari</button>
        </form>

        <!-- Filter status -->
        <div class="flex flex-wrap gap-2 mb-6">
            <% chips.forEach(function (c) { %>
                <a href="/admin/produk?status=<%= c.nilai %>&q=<%= encodeURIComponent(q) %>"
                   class="px-4 py-1.5 rounded-full text-sm font-semibold <%= status === c.nilai ? 'bg-emerald-700 text-white' : 'bg-white border border-gray-200 text-gray-700 hover:bg-gray-100' %>"><%= c.teks %></a>
            <% }); %>
        </div>

        <!-- Daftar produk -->
        <div class="space-y-3 max-w-5xl">
            <% if (daftar.length === 0) { %>
                <p class="text-sm text-gray-500">Tidak ada produk.</p>
            <% } %>

            <% daftar.forEach(function (p) { %>
                <div class="bg-white rounded-2xl border border-gray-200 p-4">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
                        <div class="flex items-center gap-4">
                            <div class="relative w-16 h-16 shrink-0 rounded-xl bg-emerald-100 text-emerald-800 font-bold flex items-center justify-center overflow-hidden">
                                <span><%= p.nama.charAt(0).toUpperCase() %></span>
                                <% if (p.gambar) { %>
                                    <img src="<%= p.gambar %>" alt="" class="absolute inset-0 w-full h-full object-cover" onerror="this.remove()">
                                <% } %>
                            </div>
                            <div>
                                <h4 class="text-lg font-bold"><%= p.nama %></h4>
                                <p class="text-sm text-gray-500"><%= p.umkm || '-' %> - <%= p.kategori %></p>
                                <p class="text-sm font-semibold"><%= formatRupiah(p.harga) %> <span class="text-gray-400">|</span> Stok: <%= p.stok %></p>
                            </div>
                        </div>
                        <div class="flex flex-wrap items-center gap-3 text-sm">
                            <span class="<%= badge[p.status] %> text-xs font-bold px-3 py-1.5 rounded-full"><%= label[p.status] %></span>

                            <% if (p.status !== 'ditampilkan') { %>
                                <form method="POST" action="/admin/produk/<%= p.id %>/verifikasi">
                                    <button class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-3 py-1.5 rounded-lg">Verifikasi</button>
                                </form>
                            <% } %>
                            <% if (p.status === 'menunggu') { %>
                                <form method="POST" action="/admin/produk/<%= p.id %>/tolak">
                                    <button class="bg-red-100 hover:bg-red-200 text-red-700 font-bold px-3 py-1.5 rounded-lg">Tolak</button>
                                </form>
                            <% } %>

                            <button type="button" onclick="togglePanel('detail-<%= p.id %>')" class="text-emerald-700 font-semibold">Detail</button>
                            <button type="button" onclick="togglePanel('edit-<%= p.id %>')" class="text-amber-600 font-semibold">Edit</button>
                            <form method="POST" action="/admin/produk/<%= p.id %>/hapus" onsubmit="return confirm('Hapus produk ini?')">
                                <button class="text-red-700 font-semibold">Hapus</button>
                            </form>
                        </div>
                    </div>

                    <!-- Panel detail -->
                    <div id="detail-<%= p.id %>" class="hidden mt-4 pt-4 border-t border-gray-100 text-sm space-y-1">
                        <p><span class="text-gray-500">Deskripsi:</span> <%= p.deskripsi || '-' %></p>
                        <p><span class="text-gray-500">UMKM:</span> <%= p.umkm || '-' %></p>
                        <p><span class="text-gray-500">WhatsApp:</span>
                            <% if (p.no_whatsapp) { %>
                                <a href="https://wa.me/<%= p.no_whatsapp %>" target="_blank" class="text-emerald-700 underline"><%= p.no_whatsapp %></a>
                            <% } else { %>-<% } %>
                        </p>
                    </div>

                    <!-- Panel edit -->
                    <div id="edit-<%= p.id %>" class="hidden mt-4 pt-4 border-t border-gray-100">
                        <form method="POST" action="/admin/produk/<%= p.id %>/edit" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <input name="nama" value="<%= p.nama %>" placeholder="Nama produk" required class="<%= input %>">
                            <select name="kategori" required class="<%= input %>">
                                <% kategori.forEach(function (k) { %>
                                    <option value="<%= k %>" <%= p.kategori === k ? 'selected' : '' %>><%= k %></option>
                                <% }); %>
                            </select>
                            <input name="harga" type="number" min="0" value="<%= p.harga %>" placeholder="Harga" required class="<%= input %>">
                            <input name="stok" type="number" min="0" value="<%= p.stok %>" placeholder="Stok" required class="<%= input %>">
                            <input name="umkm" value="<%= p.umkm || '' %>" placeholder="Nama UMKM" class="<%= input %>">
                            <input name="no_whatsapp" value="<%= p.no_whatsapp || '' %>" placeholder="No. WhatsApp" class="<%= input %>">
                            <input name="gambar" value="<%= p.gambar || '' %>" placeholder="Path gambar (contoh: /images/singkong.jpg)" class="<%= input %> md:col-span-2">
                            <textarea name="deskripsi" rows="3" placeholder="Deskripsi" class="<%= input %> md:col-span-2"><%= p.deskripsi || '' %></textarea>
                            <div class="md:col-span-2 flex gap-2">
                                <button class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-5 py-2 rounded-xl text-sm">Simpan Perubahan</button>
                                <button type="button" onclick="togglePanel('edit-<%= p.id %>')" class="border border-gray-300 px-5 py-2 rounded-xl text-sm">Batal</button>
                            </div>
                        </form>
                    </div>
                </div>
            <% }); %>
        </div>
    </main>
</div>

<script>
    function togglePanel(id) {
        document.getElementById(id).classList.toggle('hidden');
    }
</script>
<%- include('../partials/footer') %>