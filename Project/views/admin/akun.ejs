<%- include('../partials/head', { appName: appName }) %>
<body class="bg-gray-50 text-gray-800 font-sans">
<div class="min-h-screen flex flex-col md:flex-row">
    <%- include('../partials/admin-sidebar', { aktif: 'akun' }) %>

    <main class="flex-1 p-6 md:p-10">
        <h2 class="text-3xl font-extrabold text-gray-900">Akun Saya</h2>
        <p class="text-gray-600 mb-6">Kelola informasi akun anda</p>

        <div class="bg-white rounded-3xl border border-gray-200 p-8 max-w-3xl text-center mb-6">
            <div class="w-24 h-24 mx-auto rounded-full bg-gray-200 flex items-center justify-center text-4xl">
                <%= admin.username.charAt(0).toUpperCase() %>
            </div>
            <p class="mt-3 text-sm">Admin</p>
            <p class="font-semibold">AKUN ADMIN</p>
            <a href="/logout" onclick="return confirm('Yakin ingin keluar?')"
               class="inline-block mt-5 bg-red-600 hover:bg-red-700 text-white font-semibold px-8 py-2.5 rounded-xl">LOGOUT</a>
        </div>
        
        <div class="bg-white rounded-3xl border border-gray-200 p-8 max-w-3xl">
            <h3 class="text-xl mb-4">Informasi akun</h3>
            <p class="text-sm text-gray-500">Username Admin</p>
            <p class="text-lg font-medium"><%= admin.username %></p>
        </div>
    </main>
</div>
<%- include('../partials/footer') %>